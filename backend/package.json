{
  "name": "backend",
  "version": "1.0.0",
  "description": "DeskMate lets a small support team manage incoming tickets from customers, assign them to agents, and reply faster using AI-drafted responses that the agent reviews and edits before sending.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
